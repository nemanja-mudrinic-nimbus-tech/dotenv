#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  "")            exec secret-put --note ;;
  pick)          exec secret-put ;;
  get)           exec secret-put --get "${2:-}" ;;
  ls|list)       exec secret-put --list ;;
  -h|--help|help)
    cat <<'USAGE'
secret              new secure note: name → paste anything (multi-line ok) → Ctrl-D
secret pick         same, but choose the type (password / API credential / login)
secret get <name>   copy its value to the clipboard (not printed), cleared after 45 s
secret ls           list items (titles only)
More: secret-put --help (doctl/AWS import, update fields)
USAGE
    ;;
  *) echo "secret: unknown command '$1' (try: secret help)" >&2; exit 1 ;;
esac
