#!/usr/bin/env bash
set -euo pipefail

OP_VAULT="${OP_VAULT:-}"
TAG="dev-setup"

usage() {
  cat <<'EOF'
secret-put — store secrets in 1Password without them showing up anywhere

  secret-put                          interactive: name → type (secure note / password / API credential / login) → hidden value
  secret-put "<title>" [field …]      hidden prompt for each field (default field: credential)
  pbpaste | secret-put "<title>"      take the value from the clipboard (one field)
  secret-put --from-doctl <ctx> [title]  copy the token doctl holds for <ctx> → item "<title>" (default "doctl <ctx>")
  secret-put --aws "<title>"          copy AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN from this shell
  secret-put --list                   titles of everything tagged dev-setup (no values)

Items are "API Credential" in your personal vault (OP_VAULT, else Private / Employee / Personal auto-detected — override with
OP_VAULT=<name>), tagged dev-setup; re-running updates them.
Read back: op read "op://<vault>/<title>/<field>"   (secret-put prints the exact reference)
EOF
}

die() { echo "secret-put: $*" >&2; exit 1; }

require_op() {
  command -v op >/dev/null || die "1Password CLI (op) not installed"
  if ! op whoami >/dev/null 2>&1; then
    [[ -t 0 ]] && op signin >/dev/null 2>&1 && op whoami >/dev/null 2>&1 \
      || die "not signed in — unlock the 1Password app (Settings → Developer → 'Integrate with 1Password CLI'), then: op signin"
  fi
  if [[ -z "$OP_VAULT" ]]; then
    local vaults v
    vaults="$(op vault list --format json | jq -r '.[].name')"
    for v in Private Employee Personal; do
      grep -qx "$v" <<<"$vaults" && { OP_VAULT="$v"; break; }
    done
    [[ -n "$OP_VAULT" ]] || die "no personal vault found (have: $(tr '\n' ',' <<<"$vaults")) — run with OP_VAULT=<name>"
  fi
}

store() {
  local title="$1"; shift
  if op item get "$title" --vault "$OP_VAULT" >/dev/null 2>&1; then
    op item edit "$title" --vault "$OP_VAULT" "$@" >/dev/null
    echo "secret-put: updated \"$title\" (vault $OP_VAULT)"
  else
    op item create --category "API Credential" --title "$title" --vault "$OP_VAULT" --tags "$TAG" "$@" >/dev/null
    echo "secret-put: created \"$title\" (vault $OP_VAULT)"
  fi
  op item get "$title" --vault "$OP_VAULT" --format json | jq -r --arg v "$OP_VAULT" --arg t "$title" '.fields[] | select(.value != null and .value != "") | "  op://\($v)/\($t)/\(.label)"'
}

from_doctl() {
  local ctx="${1:-}" title="${2:-}" cfg token
  [[ -n "$ctx" ]] || die "usage: secret-put --from-doctl <context>"
  cfg="$HOME/Library/Application Support/doctl/config.yaml"
  [[ -f "$cfg" ]] || cfg="${XDG_CONFIG_HOME:-$HOME/.config}/doctl/config.yaml"
  [[ -f "$cfg" ]] || die "doctl config not found"
  token="$(awk -v c="$ctx" '
    /^auth-contexts:/ {in_ctx=1; next}
    in_ctx && /^[^ ]/ {in_ctx=0}
    in_ctx { line=$0; sub(/^[ ]+/, "", line); n=index(line, ": "); if (substr(line, 1, n-1) == c) { print substr(line, n+2); exit } }
  ' "$cfg")"
  [[ -n "$token" ]] || die "no token for doctl context '$ctx' (run: doctl auth init --context $ctx)"
  store "${title:-doctl $ctx}" "credential[concealed]=$token"
}

from_aws_env() {
  local title="${1:-}"
  [[ -n "$title" ]] || die "usage: secret-put --aws \"<title>\""
  [[ -n "${AWS_ACCESS_KEY_ID:-}" && -n "${AWS_SECRET_ACCESS_KEY:-}" ]] || die "AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY not set in this shell"
  local -a a=("access_key_id[text]=$AWS_ACCESS_KEY_ID" "secret_access_key[concealed]=$AWS_SECRET_ACCESS_KEY")
  [[ -n "${AWS_SESSION_TOKEN:-}" ]] && a+=("session_token[concealed]=$AWS_SESSION_TOKEN" "note[text]=temporary STS credentials, expire within hours")
  store "$title" "${a[@]}"
}

TYPES=$'Secure note\nPassword\nAPI credential\nLogin (username + password)'

pick_type() {
  if command -v fzf >/dev/null; then
    fzf --height=7 --layout=reverse --no-info --prompt="Type> " <<<"$TYPES"
  else
    local -a opts; mapfile -t opts <<<"$TYPES"
    select t in "${opts[@]}"; do [[ -n "$t" ]] && { echo "$t"; return; }; done
  fi
}

# Non-canonical so pasted lines longer than the 1024-byte tty limit survive; Ctrl-D ends input.
read_hidden_multiline() {
  local prompt="$1" saved v
  saved="$(stty -g)"
  trap 'stty "$saved"' EXIT INT
  stty -echo -icanon
  echo "$prompt" >&2
  IFS= read -r -d $'\004' v || true
  stty "$saved"; trap - EXIT INT
  echo >&2
  printf '%s' "${v%$'\n'}"
}

# Values travel to op on stdin as a JSON item, never as command arguments (visible in ps).
interactive() {
  local preset="${1:-}" title type username="" value field category
  read -r -p "Name: " title
  [[ -n "$title" ]] || die "empty name"
  op item get "$title" --vault "$OP_VAULT" >/dev/null 2>&1 && die "\"$title\" already exists in $OP_VAULT — pick another name, or update it: secret-put \"$title\" <field>"
  if [[ -n "$preset" ]]; then type="$preset"; else type="$(pick_type)" || die "no type picked"; fi
  echo "Type: $type"
  case "$type" in
    "Secure note")
      value="$(read_hidden_multiline "Paste the note, then Ctrl-D (input hidden; backspace does not edit):")"; field=notesPlain; category=SECURE_NOTE ;;
    "Password")
      read -r -s -p "Password (hidden, paste + Enter): " value; echo; field=password; category=PASSWORD ;;
    "API credential")
      read -r -s -p "Credential (hidden, paste + Enter): " value; echo; field=credential; category=API_CREDENTIAL ;;
    Login*)
      read -r -p "Username: " username
      read -r -s -p "Password (hidden, paste + Enter): " value; echo; field=password; category=LOGIN ;;
    *) die "unknown type: $type" ;;
  esac
  [[ -n "$value" ]] || die "empty value"
  echo "Got ${#value} characters."

  printf '%s' "$value" | jq -Rs --arg title "$title" --arg category "$category" --arg field "$field" --arg username "$username" '
    . as $v
    | {title: $title, category: $category, fields: (
        if $category == "SECURE_NOTE" then [{id: "notesPlain", type: "STRING", purpose: "NOTES", label: "notesPlain", value: $v}]
        elif $category == "API_CREDENTIAL" then [{id: "credential", type: "CONCEALED", label: "credential", value: $v}]
        else
          (if $username != "" then [{id: "username", type: "STRING", purpose: "USERNAME", label: "username", value: $username}] else [] end)
          + [{id: "password", type: "CONCEALED", purpose: "PASSWORD", label: "password", value: $v}]
        end)}' \
    | op item create --vault "$OP_VAULT" --tags "$TAG" - >/dev/null
  echo "secret-put: created \"$title\" ($type, vault $OP_VAULT)"
  echo "  op://$OP_VAULT/$title/$field"
}

# Copies the item's secret to the clipboard (never printed), cleared after 45 s unless something else was copied.
get_to_clipboard() {
  local title="$1" value
  [[ -n "$title" ]] || die "usage: secret get <name>"
  value="$(op item get "$title" --vault "$OP_VAULT" --format json 2>/dev/null | jq -r '
    [.fields[] | select(.value != null and .value != "")]
    | (map(select(.purpose == "NOTES" or .purpose == "PASSWORD" or .type == "CONCEALED")) + .) | .[0].value // empty')" \
    || true
  [[ -n "$value" ]] || die "no item \"$title\" with a value in $OP_VAULT (see: secret ls)"
  printf '%s' "$value" | pbcopy
  echo "secret: \"$title\" copied — clipboard clears in 45 s"
  local sum; sum="$(printf '%s' "$value" | shasum | cut -c1-40)"
  ( sleep 45; [[ "$(pbpaste | shasum | cut -c1-40)" == "$sum" ]] && printf '' | pbcopy ) >/dev/null 2>&1 &
  disown
}

prompt_fields() {
  local title="$1"; shift
  local -a fields=("$@") assignments=()
  [[ ${#fields[@]} -gt 0 ]] || fields=(credential)
  local f value
  for f in "${fields[@]}"; do
    if [[ -t 0 ]]; then
      read -r -s -p "$f for \"$title\" (hidden, paste + Enter): " value; echo
    else
      IFS= read -r value || true
    fi
    [[ -n "$value" ]] || die "empty value for $f"
    assignments+=("${f}[concealed]=$value")
  done
  store "$title" "${assignments[@]}"
}

case "${1:-}" in
  -h|--help)    usage ;;
  "")           require_op; interactive ;;
  --note)       require_op; interactive "Secure note" ;;
  --get)        require_op; get_to_clipboard "${2:-}" ;;
  --list)       require_op; op item list --tags "$TAG" --format json | jq -r '.[] | "\(.title)\t[\(.vault.name)]\t\(.updated_at[0:10])"' ;;
  --from-doctl) require_op; from_doctl "${2:-}" "${3:-}" ;;
  --aws)        require_op; from_aws_env "${2:-}" ;;
  *)            require_op; title="$1"; shift; prompt_fields "$title" "$@" ;;
esac
