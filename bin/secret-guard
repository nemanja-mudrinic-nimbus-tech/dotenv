#!/usr/bin/env bash
set -uo pipefail

input="$(cat)"
file="$(jq -r '.tool_input.file_path // empty' <<<"$input")"
[[ -n "$file" && -f "$file" ]] || exit 0

case "$file" in
  */sensitive/*|"$HOME/.secrets"|*.env.tpl) exit 0 ;;
esac

report="$(gitleaks dir "$file" --no-banner --redact --exit-code 3 --log-level error --report-format json --report-path - 2>/dev/null)"
status=$?
[[ $status == 3 ]] || exit 0

rules="$(jq -r '[.[].RuleID] | unique | join(", ")' <<<"$report" 2>/dev/null)"
cat >&2 <<EOF
secret-guard: possible secret written to $file (${rules:-unknown rule}).
Tell the user, and suggest moving it to 1Password instead of keeping it in this file:
  op item create --category "API Credential" --title "<name>" --vault Private credential=<value>
then reference it as op://Private/<name>/credential (op run / op read / sqmeow {{ exec "op read …" }}).
Never commit this file while the secret is in it.
EOF
exit 2
