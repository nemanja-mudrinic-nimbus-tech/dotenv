#!/usr/bin/env bash
# aero-summon <bundle-id> <home-workspace>
# Brings the app's window next to you; if it is already on your workspace, sends it back home.
set -euo pipefail

bundle="${1:?usage: aero-summon <bundle-id> <home-workspace>}"
home="${2:?usage: aero-summon <bundle-id> <home-workspace>}"

here="$(aerospace list-workspaces --focused)"
read -r id ws < <(aerospace list-windows --all --format '%{window-id} %{app-bundle-id} %{workspace}' |
  awk -v b="$bundle" '$2 == b { print $1, $3; exit }') || true

if [[ -z "${id:-}" ]]; then
  open -b "$bundle"
elif [[ "$ws" == "$here" ]]; then
  aerospace move-node-to-workspace --window-id "$id" "$home"
else
  aerospace move-node-to-workspace --window-id "$id" "$here"
  aerospace focus --window-id "$id"
fi
