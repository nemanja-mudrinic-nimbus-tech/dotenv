#!/usr/bin/env bash
set -euo pipefail

DIR="${GITID_DIR:-$HOME/.config/gitid}"
PROFILES="$DIR/profiles.tsv"
FOLDERS="$DIR/folders.tsv"
OUT="$HOME/.config/git/gitid"
OP_VAULT="${OP_VAULT:-Private}"
EXAMPLES="$HOME/.dotfiles/git"

usage() {
  cat <<'EOF'
gitid — one git identity (name, email, SSH key) per folder, so parallel sessions never mix accounts

  gitid            show the identity git uses here, and where it comes from
  gitid list       profiles and folder rules
  gitid set [p]    map this repo's folder to profile p (fzf if omitted), then apply
  gitid apply      write the git config from ~/.config/gitid/{profiles,folders}.tsv
  gitid check      every repo under ~/Documents: identity it will use, and conflicts with old per-repo settings
  gitid backup     save both files to 1Password (vault "$OP_VAULT"; after every change)
  gitid restore    get both files from 1Password (new Mac); without a backup, start from ~/.dotfiles/git/*.example.tsv

The files hold client names and emails, so they live outside the public repo.

In a folder without a rule git refuses to commit (user.useConfigOnly), so a wrong identity cannot slip in.
EOF
}

die() { echo "gitid: $*" >&2; exit 1; }
need_files() { [[ -f "$PROFILES" && -f "$FOLDERS" ]] || die "no $PROFILES — run: gitid restore"; }
rows() { grep -v '^#' "$1" | grep -v '^[[:space:]]*$'; }
expand() { echo "${1/#\~/$HOME}"; }

profile_line() { rows "$PROFILES" | awk -F'\t' -v p="$1" '$1 == p'; }

apply() {
  mkdir -p "$OUT"
  rm -f "$OUT"/*.gitconfig
  local p name email key
  while IFS=$'\t' read -r p name email key; do
    [[ -f "$HOME/.ssh/$key" || -f "$HOME/.ssh/$key.pub" ]] || echo "gitid: warning — ~/.ssh/$key not found (profile $p)" >&2
    printf '[user]\n\tname = %s\n\temail = %s\n[core]\n\tsshCommand = ssh -i ~/.ssh/%s -o IdentitiesOnly=yes\n' \
      "$name" "$email" "$key" > "$OUT/$p.gitconfig"
  done < <(rows "$PROFILES")

  # git applies every matching includeIf and the last one wins, so write broad folders first
  {
    echo "# generated by gitid from ~/.config/gitid — edit folders.tsv / profiles.tsv, then: gitid apply"
    local folder
    while IFS=$'\t' read -r folder p; do
      [[ -f "$OUT/$p.gitconfig" ]] || die "folders.tsv names unknown profile '$p'"
      printf '[includeIf "gitdir:%s/"]\n\tpath = %s\n' "$(expand "$folder")" "$OUT/$p.gitconfig"
    done < <(rows "$FOLDERS" | tail -r)
  } > "$OUT/rules.gitconfig"

  git config --global --get-all include.path 2>/dev/null | grep -qxF "$OUT/rules.gitconfig" ||
    git config --global --add include.path "$OUT/rules.gitconfig"
  git config --global user.useConfigOnly true
  git config --global --unset user.email 2>/dev/null || true
  echo "gitid: applied $(rows "$PROFILES" | wc -l | tr -d ' ') profiles, $(rows "$FOLDERS" | wc -l | tr -d ' ') folder rules"
}

show() {
  local email name ssh
  email="$(git config user.email 2>/dev/null || true)"
  name="$(git config user.name 2>/dev/null || true)"
  ssh="$(git config core.sshCommand 2>/dev/null || true)"
  if [[ -z "$email" ]]; then
    echo "no identity here — git will refuse to commit. Run: gitid set"
    return 1
  fi
  echo "$name <$email>"
  echo "ssh:  ${ssh:-default}"
  echo "from: $(git config --show-origin user.email | cut -f1 | sed "s|$HOME|~|")"
}

set_rule() {
  local root p
  root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  p="${1:-}"
  if [[ -z "$p" ]]; then
    p="$(rows "$PROFILES" | awk -F'\t' '{printf "%s\t%s <%s>\n", $1, $2, $3}' |
      fzf --delimiter=$'\t' --header="Identity for ${root/#$HOME/~}" | cut -f1)" || exit 0
  fi
  [[ -n "$(profile_line "$p")" ]] || die "unknown profile '$p' (see: gitid list)"
  local rel="${root/#$HOME/~}"
  { head -1 "$FOLDERS"; printf '%s\t%s\n' "$rel" "$p"; rows "$FOLDERS" | awk -F'\t' -v f="$rel" '$1 != f'; } > "$FOLDERS.tmp"
  mv "$FOLDERS.tmp" "$FOLDERS"
  apply
  (cd "$root" && show)
}

check() {
  local g r got local_email
  while IFS= read -r g; do
    r="${g%/.git}"
    got="$(git -C "$r" config user.email 2>/dev/null || echo "— refuses commits")"
    local_email="$(git -C "$r" config --local user.email 2>/dev/null || true)"
    printf '%-60s %s%s\n' "${r/#$HOME/~}" "$got" "${local_email:+  (repo setting overrides)}"
  done < <(find "$HOME/Documents" -maxdepth 4 -name .git -type d -not -path '*/node_modules/*' 2>/dev/null | sort)
}

backup() {
  need_files
  local f title
  for f in profiles folders; do
    title="gitid $f.tsv"
    if op document get "$title" --vault "$OP_VAULT" &> /dev/null; then
      op document edit "$title" "$DIR/$f.tsv" --vault "$OP_VAULT" > /dev/null
    else
      op document create "$DIR/$f.tsv" --title "$title" --vault "$OP_VAULT" --tags dev-setup > /dev/null
    fi
  done
  echo "gitid: saved profiles.tsv and folders.tsv to 1Password ($OP_VAULT)"
}

restore() {
  mkdir -p "$DIR"
  local f
  for f in profiles folders; do
    [[ -f "$DIR/$f.tsv" ]] && die "$DIR/$f.tsv exists — move it away first"
  done
  if op document get "gitid profiles.tsv" --vault "$OP_VAULT" --out-file "$DIR/profiles.tsv" &> /dev/null &&
     op document get "gitid folders.tsv" --vault "$OP_VAULT" --out-file "$DIR/folders.tsv" &> /dev/null; then
    echo "gitid: restored from 1Password ($OP_VAULT)"
  else
    rm -f "$DIR/profiles.tsv" "$DIR/folders.tsv"
    cp "$EXAMPLES/profiles.example.tsv" "$DIR/profiles.tsv"
    cp "$EXAMPLES/folders.example.tsv" "$DIR/folders.tsv"
    echo "gitid: no backup in 1Password — copied the examples to $DIR; edit them, then: gitid apply && gitid backup"
  fi
}

case "${1:-}" in
  backup) backup; exit ;;
  restore) restore; exit ;;
  -h|--help|help) usage; exit ;;
esac
need_files

case "${1:-}" in
  "") show ;;
  list) rows "$PROFILES" | column -t -s $'\t'; echo; rows "$FOLDERS" | column -t -s $'\t' ;;
  set) shift; set_rule "${1:-}" ;;
  apply) apply ;;
  check) check ;;
  -h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
