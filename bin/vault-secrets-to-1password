#!/usr/bin/env bash
set -euo pipefail

VAULT_DIR="${VAULT_DIR:-$HOME/vault}"
OP_VAULT="${OP_VAULT:-Private}"
TAG="vault-sensitive"
APPLY=0
[[ "${1:-}" == "--apply" ]] && APPLY=1

usage() {
  cat <<EOF
vault-secrets-to-1password — back up every file under ~/vault/**/sensitive/ into 1Password

  vault-secrets-to-1password            dry run: list what would be created/updated
  vault-secrets-to-1password --apply    create/update one 1Password Document per file

Each file becomes a Document titled "vault/<project>/<file>" in vault "\$OP_VAULT"
(default: Private), tagged "$TAG". Re-running updates existing documents.
Local files are NOT deleted — they stay gitignored. Check in 1Password, then decide.
Requires: op signin (1Password app integration or 'eval \$(op signin)').
EOF
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }
command -v op >/dev/null || { echo "op (1Password CLI) not installed" >&2; exit 1; }
if ! op whoami >/dev/null 2>&1; then
  echo "Not signed in to 1Password CLI. Run: op signin   (or enable CLI integration in the 1Password app)" >&2
  exit 1
fi
op vault get "$OP_VAULT" >/dev/null 2>&1 || { echo "1Password vault '$OP_VAULT' not found — set OP_VAULT=<name>" >&2; exit 1; }

existing="$(op item list --vault "$OP_VAULT" --tags "$TAG" --format json 2>/dev/null | jq -r '.[].title' || true)"

created=0 updated=0
while IFS= read -r -d '' file; do
  rel="${file#"$VAULT_DIR"/projects/}"
  project="${rel%%/*}"
  title="vault/$project/$(basename "$file")"
  if grep -qxF "$title" <<<"$existing"; then
    action="update"
  else
    action="create"
  fi
  printf '%-7s %s\n' "$action" "$title"
  [[ $APPLY == 1 ]] || continue
  if [[ "$action" == "update" ]]; then
    op document edit "$title" "$file" --vault "$OP_VAULT" >/dev/null
    updated=$((updated+1))
  else
    op document create "$file" --title "$title" --vault "$OP_VAULT" --tags "$TAG" >/dev/null
    created=$((created+1))
  fi
done < <(find "$VAULT_DIR/projects" -path '*/sensitive/*' -type f -print0 | sort -z)

if [[ $APPLY == 1 ]]; then
  echo "done: $created created, $updated updated in 1Password vault '$OP_VAULT' (tag: $TAG)"
else
  echo "dry run — re-run with --apply to write to 1Password"
fi
