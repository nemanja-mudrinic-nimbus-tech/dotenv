#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
history-secrets — find secrets in your shell history, keep the ones you need in 1Password, then remove them all

  history-secrets          scan ~/.zsh_history and atuin, ask per secret, then clean both
  history-secrets --scan   only list what was found (values masked), change nothing
  history-secrets --save-all   no questions: save every secret to 1Password (OP_VAULT, default Private), then clean

Per secret you choose: [s] save to 1Password first · [d] just delete · [k] keep in history · [q] stop (nothing is cleaned).
Values are never printed; only the first 4 characters show.
EOF
}

die() { echo "history-secrets: $*" >&2; exit 1; }

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }
SCAN_ONLY=0; [[ "${1:-}" == "--scan" ]] && SCAN_ONLY=1
SAVE_ALL=0; [[ "${1:-}" == "--save-all" ]] && SAVE_ALL=1
command -v gitleaks >/dev/null || die "gitleaks is not installed"
command -v jq >/dev/null || die "jq is not installed"

work="$(mktemp -d)"; chmod 700 "$work"
trap 'rm -rf "$work"' EXIT
mkdir "$work/in"
cp ~/.zsh_history "$work/in/zsh_history"
if command -v atuin >/dev/null; then
  ATUIN_SESSION="$(atuin uuid)" atuin search --cmd-only 2>/dev/null > "$work/in/atuin" || true
fi

gitleaks dir "$work/in" --no-banner --log-level error --report-format json --report-path "$work/report.json" --exit-code 0
jq -r '[.[] | {rule: .RuleID, secret: .Secret}] | unique_by(.secret) | .[] | [.rule, .secret] | @tsv' "$work/report.json" > "$work/found.tsv"
total="$(wc -l < "$work/found.tsv" | tr -d ' ')"
[[ "$total" -gt 0 ]] || { echo "No secrets found in history."; exit 0; }

mask() { local v="$1"; printf '%s…(%d chars)' "${v:0:4}" "${#v}"; }
context() { grep -m1 -F -- "$1" "$work/in/zsh_history" "$work/in/atuin" 2>/dev/null | cut -d: -f2- | sed "s|$(printf '%s' "$1" | sed 's/[][\.*^$/|]/\\&/g')|<secret>|g" | cut -c1-110 | head -1; }

echo "Found $total distinct secret(s)."
if [[ $SCAN_ONLY == 1 ]]; then
  while IFS=$'\t' read -r rule secret; do
    printf '  %-28s %-22s %s\n' "$rule" "$(mask "$secret")" "$(context "$secret")"
  done < "$work/found.tsv"
  exit 0
fi

command -v op >/dev/null || die "1Password CLI (op) is not installed"
op whoami >/dev/null 2>&1 || op signin >/dev/null || die "sign in to 1Password first (op signin)"
vault="${OP_VAULT:-Private}"

: > "$work/remove.txt"
n=0
while IFS=$'\t' read -r rule secret <&3; do
  n=$((n+1))
  echo
  echo "[$n/$total] $rule  $(mask "$secret")"
  echo "  used in: $(context "$secret")"
  if [[ $SAVE_ALL == 1 ]]; then
    choice=s
  else
    read -r -p "  [s]ave to 1Password · [d]elete · [k]eep · [q]uit > " choice
  fi
  case "$choice" in
    s|S)
      if [[ $SAVE_ALL == 1 ]]; then
        title="history: $rule ${secret:0:4} ($n)"
      else
        read -r -p "  1Password title (e.g. DigitalOcean sensei token): " title
      fi
      [[ -n "$title" ]] || { echo "  no title — kept in history"; continue; }
      jq -n --arg t "$title" --arg v "$secret" '{title: $t, category: "API_CREDENTIAL", tags: ["history-import"], fields: [{id: "credential", type: "CONCEALED", label: "credential", value: $v}]}' > "$work/item.json"
      chmod 600 "$work/item.json"
      op item create --vault "$vault" --template "$work/item.json" >/dev/null
      rm -f "$work/item.json"
      echo "  saved: op://$vault/$title/credential"
      printf '%s\n' "$secret" >> "$work/remove.txt" ;;
    d|D) printf '%s\n' "$secret" >> "$work/remove.txt" ;;
    q|Q) echo "Stopped. Nothing was removed."; exit 0 ;;
    *) echo "  kept" ;;
  esac
done 3< "$work/found.tsv"

removed="$(wc -l < "$work/remove.txt" | tr -d ' ')"
[[ "$removed" -gt 0 ]] || { echo "Nothing to remove."; exit 0; }

python3 - "$work/remove.txt" <<'PY'
import pathlib, re, sys
secrets = [s.encode() for s in pathlib.Path(sys.argv[1]).read_text().splitlines() if s]
hist = pathlib.Path.home() / ".zsh_history"
entries = re.split(rb'(?m)^(?=: \d+:\d+;)', hist.read_bytes())
# zsh stores multi-line commands with a backslash before each newline
kept = [e for e in entries if not any(s in e or s in e.replace(b"\\\n", b"\n") for s in secrets)]
hist.write_bytes(b"".join(kept))
print(f"zsh history: removed {len(entries) - len(kept)} command(s)")
PY

if command -v atuin >/dev/null; then
  count=0
  while IFS= read -r secret; do
    ATUIN_SESSION="$(atuin uuid)" atuin search --delete --search-mode full-text -- "$secret" >/dev/null 2>&1 && count=$((count+1)) || true
  done < "$work/remove.txt"
  echo "atuin: cleaned $count secret(s)"
fi

echo "Done. Rotate any long-lived token that was in history (it may also be in backups)."
echo "Open shells still hold old history in memory: run 'exec zsh' in each, or the old lines come back on exit."
