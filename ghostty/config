# Moss terminal — mockup A3: IBM Plex Mono (BlexMono Nerd Font), opaque, padded
theme = moss
font-family = "BlexMono Nerd Font Mono"
adjust-cell-height = 15%
font-size = 17

shell-integration = zsh
shell-integration-features = no-cursor

cursor-style = block
cursor-style-blink = true

# Window
window-width = 115
window-height = 45
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true
mouse-hide-while-typing = true

# Newline for Claude Code
keybind = shift+enter=text:\x1b\r

# Cmd+Left = start of line. The default sends Ctrl+A, which is the tmux prefix;
# Ctrl+A twice makes tmux pass one Ctrl+A through (bind C-a send-prefix).
keybind = super+arrow_left=text:\x01\x01

# Panes are owned by tmux (Ctrl+hjkl). Ghostty keeps only its
# Cmd-based split defaults (Cmd+D split, Cmd+Alt+arrows navigate),
# so nothing collides with tmux or nvim.
